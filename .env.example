# LawAnswer 配置样例：cp .env.example .env 后按需修改
# 注意：**大模型密钥不写在这里**，只放系统环境变量
#       （LLM_API_KEY / DEEPSEEK_API_KEY / DASHSCOPE_API_KEY 任选其一）；
#       写在 .env 里会被启动自检直接拒绝（config.assert_secrets_not_in_dotenv）。
# 生产环境请修改 MySQL/Redis 密码与 JWT_SECRET。

# ============================================================================
# LawAnswer 配置模板  ->  复制为 .env 后按需修改
#   cp .env.example .env
#
# 【安全红线】大模型密钥不进本文件、不进代码、不进仓库。
#   只从系统环境变量读取：DASHSCOPE_API_KEY
#   PowerShell 临时设置：$env:DASHSCOPE_API_KEY="sk-xxx"
#   永久设置：setx DASHSCOPE_API_KEY "sk-xxx"（需重开终端）
#   应用启动时会自检：若本文件中出现 DASHSCOPE_API_KEY / API_KEY，直接拒绝启动。
# ============================================================================

# ---------- 应用 ----------
APP_NAME=LawAnswer
APP_ENV=dev
DEBUG=false
APP_VERSION=0.1.0
SERVER_HOST=127.0.0.1
SERVER_PORT=8101
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# ---------- 鉴权 ----------
JWT_SECRET=dev-only-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
CAPTCHA_TTL_S=120
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_S=60

# ---------- MySQL（容器 lawanswer-mysql，宿主 3307）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=lawanswer
MYSQL_PASSWORD=lawanswer_dev_pwd
MYSQL_ROOT_PASSWORD=root_dev_pwd
MYSQL_DB=lawanswer
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT=5

# ---------- Redis（容器 lawanswer-redis，宿主 6380，db 3 避免与其他项目混淆）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=3
REDIS_PASSWORD=

# ---------- Milvus（容器 lawanswer-milvus，宿主 19531）----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19531
MILVUS_DB=lawanswer
MILVUS_COLLECTION=law_chunks
MILVUS_TIMEOUT=5

# ---------- 大模型（OpenAI 兼容协议；密钥只从系统环境变量读，此处绝不配置）----------
# 切换厂商只需改下面三行 + 设置对应的密钥环境变量（三种变量名任选其一）：
#   1) DeepSeek（当前启用）  base_url = https://api.deepseek.com
#                            模型 deepseek-flash（或 deepseek-v4-pro），密钥 DEEPSEEK_API_KEY
#                            LLM_THINKING=disabled：关闭思考模式（默认 enabled，会忽略
#                            temperature、默认 8K→64K 输出、延迟与费用显著上升）
#   2) 阿里云百炼 DashScope  base_url = https://dashscope.aliyuncs.com/compatible-mode/v1
#                            模型 qwen-max，密钥 DASHSCOPE_API_KEY（qwen3 系同样需要 LLM_THINKING=disabled）
#   3) 通用写法              任意兼容服务，密钥变量统一用 LLM_API_KEY（优先级最高）
# 图片 OCR 例外：固定走 DashScope 的 qwen-vl-ocr，只认 DASHSCOPE_API_KEY（DeepSeek 无视觉接口）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-max
LLM_THINKING=disabled
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# ---------- 意图识别（短超时，失败即走规则兜底，保证链路 100% 可用）----------
INTENT_TIMEOUT_S=5
INTENT_MAX_RETRIES=1
INTENT_HISTORY_TURNS=2

# ---------- Embedding / Rerank（机器相关路径，换机器先改这里）----------
EMBEDDING_MODEL_PATH=C:/Users/Administrator/.cache/huggingface/hub/models--BAAI--bge-m3
# 本机 PyPI 版 torch 是 CPU 构建（torch.cuda.is_available()=False），先用 cpu；
# 装好 CUDA 版 torch 后改成 cuda，代码会自动检测并回退
EMBEDDING_DEVICE=cuda
EMBEDDING_FP16=true
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
RERANKER_MAX_TEXT_CHARS=400

# ---------- 分块与检索 ----------
CHUNK_DEFAULT_SIZE=300
CHUNK_DEFAULT_OVERLAP=50
RETRIEVAL_RRF_K=60
RETRIEVAL_POOL_FACTOR=4
RETRIEVAL_POOL_MIN=12
RETRIEVAL_TOPK_SIMPLE=3
RETRIEVAL_TOPK_MEDIUM=5
RETRIEVAL_TOPK_COMPLEX=8
# 混合检索融合：rrf=等权（默认，实测最稳）/ weighted=稠密主导（实测无收益，仅作对照）
RETRIEVAL_RANKER=rrf
RETRIEVAL_DENSE_WEIGHT=0.75
RETRIEVAL_SPARSE_WEIGHT=0.25
# 用意图层 law_hints 做检索法域过滤（false 时全库检索）
RETRIEVAL_LAW_FILTER=true
# 法域过滤低置信回退阈值（top1 重排分低于此值则无过滤重查合并；0=关闭）
RETRIEVAL_LAW_RESCUE_SCORE=0.5
QA_SIMILARITY_THRESHOLD=0.90
QA_BM25_TOPN=3
CACHE_QA_TTL=604800

# ---------- 生成链路（阶段 5）----------
GEN_CONTEXT_MAX_CHARS=6000
GEN_HISTORY_MAX_ROUNDS=5
GEN_HISTORY_TOKEN_BUDGET=2000
GEN_MAX_TOKENS=2048
GEN_TEMPERATURE=0.3
GEN_REPLAY_CHUNK_CHARS=30
GEN_SOURCES_LIMIT=10

# ---------- 意图识别 ----------
# 意图结果 Redis 缓存 TTL（秒），0=关闭；只缓存无历史问题的 LLM 成功结果。
# 注意：修改意图 Prompt 后需删除 Redis 中的 intent:* 键，否则旧判定最长回放 1 天
INTENT_CACHE_TTL=86400

# ---------- 限流（chat 接口）----------
# 总开关；压测时临时以 RATE_LIMIT_ENABLED=false 启动服务（否则压测会被 429 卡死）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS=20
RATE_LIMIT_AUTHED=60

# ---------- 日志（控制台 + 文件双写）----------
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---------- 存储 ----------
DATA_DIR=data
UPLOAD_DIR=data/uploads
MINIO_ENABLED=true
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lawanswer
