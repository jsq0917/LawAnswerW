# ============================================================================
# LawAnswer 生产环境配置模板
#
# 放置位置：/etc/lawanswer/lawanswer.env       权限必须是 600、属主 root
#    sudo install -o root -g root -m 600 production.env.example /etc/lawanswer/lawanswer.env
#    sudo vi /etc/lawanswer/lawanswer.env        # 逐项替换 <> 占位内容
#
# 【为什么密钥放在这里而不是项目根的 .env】
# 项目有启动自检 config.assert_secrets_not_in_dotenv：只要项目根目录的 .env
# 里出现密钥赋值行，应用会直接拒绝启动。放到 /etc/lawanswer/ 下的独立文件，
# 既避开该检查，又能用文件权限锁住密钥。
#
#   LLM_API_KEY / DEEPSEEK_API_KEY / DASHSCOPE_API_KEY 三选一（优先级从左到右）
# ============================================================================

# ---------- 应用 ----------
APP_NAME=LawAnswer
APP_ENV=prod
DEBUG=false
APP_VERSION=0.1.0

# 保持 127.0.0.1：只允许 nginx 本机反代访问，不直接暴露 8101 到公网
SERVER_HOST=127.0.0.1
SERVER_PORT=8101

# 改成你的备案域名（多个用逗号分隔，必须带协议与端口，不要留尾斜杠）
CORS_ORIGINS=https://lawanswer.example.com

# anyio 线程池容量：SSE 每帧占一个线程，按机器核数调低（2 核设 60，8 核可设 120）
SERVER_THREAD_TOKENS=60

# ---------- 鉴权 ----------
# 必改！生成方式：openssl rand -hex 32
# APP_ENV=prod 时若仍是默认值，应用会直接拒绝启动
JWT_SECRET=<必改为 openssl rand -hex 32 的输出>
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
CAPTCHA_TTL_S=120
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_S=60

# ---------- MySQL（容器 lawanswer-mysql，宿主端口 3307，勿对公网开放）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=lawanswer
MYSQL_PASSWORD=<必改为强密码>
MYSQL_ROOT_PASSWORD=<必改为强密码>
MYSQL_DB=lawanswer
# 小内存机器把连接池调小，避免 MySQL 端连接数与内存一起涨
MYSQL_POOL_SIZE=5
MYSQL_CONNECT_TIMEOUT=5

# ---------- Redis（容器 lawanswer-redis，宿主端口 6380）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=3
# 建议设置 Redis 密码（docker-compose 需同步加 --requirepass）
REDIS_PASSWORD=

# ---------- Milvus（容器 lawanswer-milvus，宿主端口 19531）----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19531
MILVUS_DB=lawanswer
MILVUS_COLLECTION=law_chunks
MILVUS_TIMEOUT=10

# ---------- 大模型（OpenAI 兼容协议）----------
# DeepSeek：   base_url=https://api.deepseek.com            model=deepseek-flash   key=DEEPSEEK_API_KEY
# 阿里云百炼： base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
#                                                          model=qwen-max        key=DASHSCOPE_API_KEY
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-max
# qwen3 系 / DeepSeek 必须 disabled：否则默认开思考模式，TTFT 会飙到 17-26s
LLM_THINKING=disabled
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# >>> 密钥：只写在这里，绝不写进项目根的 .env <<<
# 三种变量名任选其一，按 LLM_API_KEY → DEEPSEEK_API_KEY → DASHSCOPE_API_KEY 取第一个非空
LLM_API_KEY=<sk-xxxxxxxxxxxxxxxxxxxxxxxx>
# DEEPSEEK_API_KEY=<sk-xxxxxxxxxxxxxxxxxxxxxxxx>
# DASHSCOPE_API_KEY=<sk-xxxxxxxxxxxxxxxxxxxxxxxx>

# ---------- 意图识别 ----------
INTENT_TIMEOUT_S=5
INTENT_MAX_RETRIES=1
INTENT_HISTORY_TURNS=2
INTENT_CACHE_TTL=86400

# ---------- Embedding / Rerank ----------
# 服务器上是 Linux 路径！不要沿用本地 Windows 的 C:/Users/... 路径，
# 否则模型加载直接失败。推荐统一放在 /opt/lawanswer/models/ 下。
EMBEDDING_MODEL_PATH=/opt/lawanswer/models/bge-m3
# 通用型 ECS 无 GPU，必须 cpu；代码会自动检测并回退，但显式声明更清晰
EMBEDDING_DEVICE=cpu
# CPU 上 fp16 无收益且可能更慢，关闭
EMBEDDING_FP16=false
# 按核数调小：2 核设 8，8 核可设 16
EMBEDDING_BATCH_SIZE=8

RERANKER_MODEL_PATH=/opt/lawanswer/models/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_MAX_TEXT_CHARS=400

# ---------- 分块与检索（保持与本地一致，勿随意改，会影响检索指标）----------
CHUNK_DEFAULT_SIZE=300
CHUNK_DEFAULT_OVERLAP=50
RETRIEVAL_RRF_K=60
RETRIEVAL_POOL_FACTOR=4
RETRIEVAL_POOL_MIN=12
RETRIEVAL_TOPK_SIMPLE=3
RETRIEVAL_TOPK_MEDIUM=5
RETRIEVAL_TOPK_COMPLEX=8
RETRIEVAL_RANKER=rrf
RETRIEVAL_DENSE_WEIGHT=0.75
RETRIEVAL_SPARSE_WEIGHT=0.25
RETRIEVAL_LAW_FILTER=true
RETRIEVAL_LAW_RESCUE_SCORE=0.5
QA_SIMILARITY_THRESHOLD=0.90
QA_BM25_TOPN=3
CACHE_QA_TTL=604800

# ---------- 生成链路 ----------
GEN_CONTEXT_MAX_CHARS=6000
GEN_HISTORY_MAX_ROUNDS=5
GEN_HISTORY_TOKEN_BUDGET=2000
GEN_MAX_TOKENS=2048
GEN_TEMPERATURE=0.3
GEN_REPLAY_CHUNK_CHARS=30
GEN_SOURCES_LIMIT=10

# ---------- 限流（务必保持开启，防止 LLM 费用被刷爆）----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS=20
RATE_LIMIT_AUTHED=60

# ---------- 日志 ----------
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---------- 存储 ----------
DATA_DIR=data
UPLOAD_DIR=data/uploads
# 应用层不直接使用 MinIO（grep 无调用点），容器仅作为 Milvus 的内部存储后端。
# 保持 true 不影响运行；如需彻底关闭应用侧引用可置 false。
MINIO_ENABLED=false
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=<建议改为强口令>
MINIO_SECRET_KEY=<建议改为强口令>
MINIO_BUCKET=lawanswer